NEXT_PUBLIC_APP_URL=https://developer.dhem.io
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_IMAGE_DOMAIN=

# DB
DATABASE_URL=

# Sending emails
RESEND_API_KEY=
EMAIL_SENDER=

# Analytics
ANALYTICS_URL=
ANALYTICS_WEBSITE_ID=

# Upstash Redis (Rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Blog runtime: public custom-domain R2 CDN (HTTPS origin, no path; not r2.dev).
# Also set NEXT_PUBLIC_APP_URL and BLOG_CDN_URL for the Worker environment.
# Worker reads use BLOG_CONTENT binding in wrangler.jsonc, not these S3 credentials.
BLOG_CDN_URL=
BLOG_AUTHOR=Murtaza Baanihali

# LOCAL ONLY — bucket-scoped R2 S3 API token. Never configure these on the Worker.
BLOG_R2_ACCOUNT_ID=
BLOG_R2_BUCKET=portfolio-blog
BLOG_R2_ACCESS_KEY_ID=
BLOG_R2_SECRET_ACCESS_KEY=

# LOCAL ONLY — optional paid generation. Set model IDs supported by your provider.
OPENROUTER_API_KEY=
BLOG_AI_BASE_URL=https://openrouter.ai/api/v1
# Ordered comma-separated models: preferred first, then fallbacks (maximum five).
BLOG_TEXT_MODELS=
BLOG_IMAGE_MODELS=
BLOG_CONCURRENCY=2
BLOG_RESEARCH_TIMEOUT_MS=25000
# Optional override. Default resolves relative to tools/blog, not the working directory.
BLOG_CONTEXT_PATH=
# EDITOR must be an executable path; use a wrapper executable for flags.
EDITOR=vi

