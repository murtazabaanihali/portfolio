NEXT_PUBLIC_APP_URL=https://dev.dhem.io
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_MEDIA_CDN_DOMAIN=

# DB
DATABASE_URL=

# Sending emails
RESEND_API_KEY=
EMAIL_SENDER=

# Analytics
ANALYTICS_URL=
ANALYTICS_WEBSITE_ID=

# Upstash Redis (Rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Also set NEXT_PUBLIC_APP_URL and NEXT_PUBLIC_MEDIA_CDN_DOMAIN for the Worker environment.
# Worker reads use BLOG_CONTENT binding in wrangler.jsonc, not these S3 credentials.
BLOG_AUTHOR=Murtaza Baanihali

# LOCAL ONLY — bucket-scoped R2 S3 API token. Never configure these on the Worker.
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET=portfolio-blog
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# LOCAL ONLY — Free-tier AI Providers (configure at least one; all models defined in tools/blog/models.config.ts)
# 1. Google AI Studio (Recommended: 1M context, 1M TPM, 1,500 RPD free): https://aistudio.google.com/
GEMINI_API_KEY=
# 2. Mistral AI (Codestral 256K, Mistral Small 128K free experiment tier): https://console.mistral.ai/
MISTRAL_API_KEY=
# 3. Groq Cloud (Ultra-fast LPU inference, free tier for planning & tools): https://console.groq.com/
GROQ_API_KEY=
# 4. OpenRouter (Free models: Nemotron 1M, Gemma 4, Inkling 1M, Cohere): https://openrouter.ai/
OPENROUTER_API_KEY=
# 5. Z.AI / Zhipu (GLM-4-Flash permanent free tier, 128K context): https://z.ai/ or https://bigmodel.cn/
ZAI_API_KEY=

# Centralized model configs, fallback chains, complexity levels, and 429 rotation
# are defined in tools/blog/models.config.ts. All default models operate on 100% free tiers.
# Optional overrides (leave empty to use centralized configuration and automatic rotation):
BLOG_TEXT_MODELS=
BLOG_RESEARCH_MODELS=
BLOG_IMAGE_MODELS=
BLOG_AI_BASE_URL=

# Output ceiling, not a length target. Writer model must support this (range 24000–65536).
BLOG_WRITING_MAX_TOKENS=24000
BLOG_CONCURRENCY=2
BLOG_RESEARCH_TIMEOUT_MS=25000
# Optional override. Default resolves relative to tools/blog, not the working directory.
BLOG_CONTEXT_PATH=
# EDITOR must be an executable path; use a wrapper executable for flags.
EDITOR=vi

